{
  "api_url": "http://192.168.1.3:7870/api/predict",
  "api_method": "POST",
  "api_headers": {
    "Content-Type": "application/json"
  },
  "payload_format": {
    "source_image": "{source_base64}",
    "target_image": "{target_base64}"
  },
  "response_type": "json",
  "response_key": "result",
  "source_image_path": "source",
  "target_image_path": "target",
  "output_dir": "output",
  "hash_algorithm": "sha256",
  "include_base64_header": false,
  "quality": 100,
  "hash_by_inputs": true,
  "facefusion_settings": {
    "processors": ["face_swapper","expression_restorer", "face_enhancer"],
    "expression_restorer_model": "live_portrait",                                                                                                                                                                 
    "expression_restorer_factor": 80,
    "face_swapper_model": "hyperswap_1a_256",
    "face_swapper_weight": 1.0,
    "face_enhancer_model": "gfpgan_1.4",
    "face_enhancer_blend": 60,
    "execution_providers": ["cuda"],
    "execution_thread_count": 8,
    "output_image_quality": 100.0,
    "face_selector_mode": "reference",
    "face_selector_order": "best-worst",
    "face_selector_gender": "female",
    "face_selector_race": "asian",
    "reference_face_distance": 0.6,
    "face_mask_types": ["box","region","occlusion"],
    "face_mask_regions": ["skin", "left-eyebrow", "right-eyebrow", "left-eye", "right-eye", "glasses", "nose", "mouth", "upper-lip", "lower-lip"],
    "face_mask_blur": 0.4,
    "face_mask_padding": [5, 5, 5, 5],
    "face_detector_angles": [0, 90, 180, 270],
    "face_detector_score": 0.2,
    "keep_temp": false
  }
}
