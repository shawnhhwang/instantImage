{
  "AppConfiguration": {
    "Environment": "Development",
    "MaxMemoryCacheMegabytes": 512,
    "DiskCacheLimitGigabytes": 10
  },
  "FileSystem": {
    "SupportedExtensions": [".jpg", ".jpeg", ".png", ".heic", ".heif", ".tiff", ".raw", ".cr2", ".nef", ".arw"],
    "EnableRealtimeFSEvents": true,
    "FSEventsDebounceMilliseconds": 300
  },
  "Rendering": {
    "TargetFPS": 120,
    "ThumbnailSize": {
      "Width": 256,
      "Height": 256
    },
    "UseMetalAcceleration": true
  },
  "Logging": {
    "Subsystem": "com.project.lumina",
    "LogLevel": "Debug",
    "LogToDisk": true
  }
}